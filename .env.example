# ============================================================
# Inmap — Environment Variables
# ============================================================
# Copy this file to `.env.local` and fill in your values.
# When these are NOT set, the app transparently uses the
# bundled local data (no backend required for development).
#
# Get these from your Supabase project:
#   Project Settings → API → Project URL / anon public key
# ============================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── 2GIS MapGL ─────────────────────────────────────────────
# Get an API key from https://dev.2gis.ru/
# When set, the app shows a 2GIS outdoor map around the NSU
# campus with a "Go Inside" button to enter the indoor view.
# Without this key, the app opens directly in indoor map mode.
VITE_2GIS_API_KEY=
